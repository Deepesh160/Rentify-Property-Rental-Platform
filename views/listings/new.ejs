<% layout("/layouts/boilerplate")%>

<div class="container">
    <div class="form-container">
        <h3>
            <i class="fa-solid fa-plus-circle me-2 text-primary"></i>
            Create New Listing
        </h3>
        
        <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
            <div class="mb-4">
                <label for="title" class="form-label">
                    <i class="fa-solid fa-heading me-2"></i>Title
                </label>
                <input 
                    name="listing[title]" 
                    id="title"
                    placeholder="Enter a catchy title for your property" 
                    type="text" 
                    class="form-control" 
                    required
                >
                <div class="valid-feedback">Title looks good!</div>
                <div class="invalid-feedback">Please provide a title.</div>
            </div>
            
            <div class="mb-4">
                <label for="description" class="form-label">
                    <i class="fa-solid fa-align-left me-2"></i>Description
                </label>
                <textarea 
                    name="listing[description]" 
                    id="description"
                    placeholder="Describe your property in detail..." 
                    class="form-control" 
                    rows="6"
                    required
                ></textarea>
                <div class="invalid-feedback">Please provide a description.</div>
            </div>

            <div class="mb-4">
                <label for="image" class="form-label">
                    <i class="fa-solid fa-image me-2"></i>Property Image
                </label>
                <input 
                    name="listing[image]" 
                    id="image"
                    type="file" 
                    class="form-control" 
                    accept="image/*"
                    required
                >
                <div class="form-text">Upload a high-quality image of your property (JPG, PNG, etc.)</div>
                <div class="invalid-feedback">Please upload an image.</div>
            </div>
            
            <div class="row">
                <div class="mb-4 col-md-4">
                    <label for="price" class="form-label">
                        <i class="fa-solid fa-indian-rupee-sign me-2"></i>Price per Night
                    </label>
                    <input 
                        name="listing[price]" 
                        id="price"
                        placeholder="Enter price" 
                        type="number" 
                        class="form-control" 
                        min="0"
                        step="1"
                        required
                    >
                    <div class="invalid-feedback">Please enter a valid price.</div>
                </div>

                <div class="mb-4 col-md-8">
                    <label for="location" class="form-label">
                        <i class="fa-solid fa-location-dot me-2"></i>Location
                    </label>
                    <input 
                        name="listing[location]" 
                        id="location"
                        placeholder="Enter city, area, or landmark" 
                        type="text" 
                        class="form-control" 
                        required
                    >
                    <div class="invalid-feedback">Please enter a location.</div>
                </div>
            </div>

            <div class="mb-4">
                <label for="country" class="form-label">
                    <i class="fa-solid fa-globe me-2"></i>Country
                </label>
                <input 
                    name="listing[country]" 
                    id="country"
                    placeholder="Enter country name" 
                    type="text" 
                    class="form-control" 
                    required
                >
                <div class="invalid-feedback">Please enter a country.</div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                <a href="/listings" class="btn btn-outline-dark">
                    <i class="fa-solid fa-times me-2"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check me-2"></i>Create Listing
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // Bootstrap validation
    (function() {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function(form) {
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>
