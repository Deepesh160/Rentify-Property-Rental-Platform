<% layout("/layouts/boilerplate")%>

<div class="container">
    <div class="row">
        <!-- Main Image -->
        <div class="col-12 mb-4 text-center">
            <img src="<%=listing.image.url%>" class="show-img" alt="<%= listing.title %>">
        </div>

        <!-- Listing Details -->
        <div class="col-12 col-lg-8">
            <div class="listing-details">
                <h3 class="mb-3"><%= listing.title %></h3>
                
                <div class="location mb-3">
                    <i class="fa-solid fa-location-dot"></i>
                    <span><%= listing.location %>, <%= listing.country %></span>
                </div>

                <div class="price mb-4">
                    &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> <span class="text-muted" style="font-size: 1rem; font-weight: 400;">/ night</span>
                </div>

                <hr class="my-4">

                <div class="mb-4">
                    <h5 class="mb-3">About this place</h5>
                    <p class="card-text" style="font-size: 1.1rem; line-height: 1.8; color: var(--text-light);">
                        <%= listing.description %>
                    </p>
                </div>

                <div class="mb-4">
                    <p class="card-text">
                        <strong>Hosted by:</strong> 
                        <span class="text-primary"><%= listing.owner.username %></span>
                    </p>
                </div>

                <!-- Owner Actions -->
                <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
                    <div class="btns">
                        <a href="/listings/<%=listing._id %>/edit" class="btn btn-primary">
                            <i class="fa-solid fa-pencil me-2"></i>Edit Listing
                        </a>
                        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="d-inline">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this listing?');">
                                <i class="fa-solid fa-trash me-2"></i>Delete Listing
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>

            <!-- Reviews Section -->
            <div class="review-section">
                <h4 class="mb-4">
                    <i class="fa-solid fa-star me-2 text-warning"></i>
                    Reviews
                    <% if(listing.reviews && listing.reviews.length > 0) { %>
                        <span class="badge bg-primary ms-2"><%= listing.reviews.length %></span>
                    <% } %>
                </h4>

                <!-- Review Form -->
                <% if(currUser) { %>
                    <div class="review-form">
                        <h5 class="mb-3">Leave a Review</h5>
                        <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
                            <div class="mb-3">
                                <label for="rating" class="form-label">Rating</label>
                                <fieldset class="starability-slot">
                                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>

                            <div class="mb-3">
                                <label for="comment" class="form-label">Comment</label>
                                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" placeholder="Share your experience..." required></textarea>
                                <div class="invalid-feedback">Please add a comment!</div>
                            </div>
                            
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-paper-plane me-2"></i>Submit Review
                            </button>
                        </form>
                    </div>
                <% } %>

                <!-- All Reviews -->
                <div class="mt-4">
                    <% if(listing.reviews && listing.reviews.length > 0) { %>
                        <div class="row g-3">
                            <% for(review of listing.reviews) {%>
                                <div class="col-12">
                                    <div class="review-card">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="card-title mb-0">
                                                <i class="fa-solid fa-user-circle me-2 text-primary"></i>
                                                <%=review.author.username %>
                                            </h5>
                                            <% if(currUser && (currUser._id.equals(review.author._id) || currUser._id.equals(listing.owner._id))) { %>
                                                <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this review?');">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                        <p class="starability-result card-text mb-2" data-rating="<%=review.rating%>"></p>
                                        <p class="card-text"><%=review.comment%></p>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-4">
                            <i class="fa-solid fa-comment-slash fa-2x text-muted mb-3"></i>
                            <p class="text-muted">No reviews yet. Be the first to review!</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Sidebar (for future enhancements) -->
        <div class="col-12 col-lg-4">
            <!-- Can add booking widget or additional info here -->
        </div>
    </div>
</div>
