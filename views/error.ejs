<% layout("/layouts/boilerplate.ejs") %>

<div class="container">
    <div class="error-container">
        <div class="alert alert-danger">
            <div class="mb-4">
                <i class="fa-solid fa-triangle-exclamation fa-4x mb-3"></i>
            </div>
            <h4 class="alert-heading mb-3"><%=message%></h4>
            <hr>
            <p class="mb-0">We're sorry, but something went wrong. Please try again or return to the homepage.</p>
        </div>
        
        <div class="mt-4">
            <a href="/listings" class="btn btn-primary btn-lg">
                <i class="fa-solid fa-home me-2"></i>Go to Homepage
            </a>
        </div>
    </div>
</div>
