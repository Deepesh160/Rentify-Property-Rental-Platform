<% layout("/layouts/boilerplate")%>

<div class="container">
    <div class="form-container">
        <div class="text-center mb-4">
            <i class="fa-solid fa-right-to-bracket fa-3x text-primary mb-3"></i>
            <h2 class="fw-bold">Welcome Back</h2>
            <p class="text-muted">Sign in to your Rentify account</p>
        </div>

        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-4">
                <label for="username" class="form-label">
                    <i class="fa-solid fa-user me-2"></i>Username
                </label>
                <input
                    name="username"
                    id="username"
                    type="text"
                    class="form-control"
                    placeholder="Enter your username"
                    required
                    autofocus
                />
                <div class="invalid-feedback">Please enter your username.</div>
            </div>
            
            <div class="mb-4">
                <label for="password" class="form-label">
                    <i class="fa-solid fa-lock me-2"></i>Password
                </label>
                <input
                    name="password"
                    id="password"
                    type="password"
                    class="form-control"
                    placeholder="Enter your password"
                    required
                />
                <div class="invalid-feedback">Please enter your password.</div>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fa-solid fa-sign-in-alt me-2"></i>Login
                </button>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted">
                    Don't have an account? 
                    <a href="/signup" class="text-primary fw-bold">Sign up here</a>
                </p>
            </div>
        </form>
    </div>
</div>

<script>
    // Bootstrap validation
    (function() {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function(form) {
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>
